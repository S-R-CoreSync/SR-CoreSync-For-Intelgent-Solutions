#!/usr/bin/env sh
# ==============================================================================
# S&R CoreSync For Intelligent Solutions - Sovereign Platform
# PROPRIETARY & CONFIDENTIAL INTELLECTUAL PROPERTY
# Git Pre-Commit Hook: Auto-Regeneration & Sovereign Security Audit
# ==============================================================================

echo "🔒 [S&R CoreSync] Executing Sovereign Secret & Credential Pre-Commit Audit..."

python scripts/audit_secrets.py --staged

EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ [S&R CoreSync] Commit rejected: Exposed secret, private key, or unauthorized token detected."
    echo "Please remove the credential from your staged changes and use Sovereign Secret Vault instead."
    exit 1
fi

echo "✅ [S&R CoreSync] Pre-commit audit passed: Zero secrets detected."

# ------------------------------------------------------------------------------
# Second gate: Automated regeneration & synchronization of all layers.
# Instead of rejecting the commit, preflight runs automatically to sync
# all language layers and parts, staging any regenerated files seamlessly.
# ------------------------------------------------------------------------------
echo "🔄 [S&R CoreSync] Auto-synchronizing language layers & site parts..."
python scripts/preflight.py

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ [S&R CoreSync] Preflight build failed: please check script syntax."
    exit 1
fi

# Automatically add any regenerated files to the current commit
git add -u index.html en/ de/ partials/ i18n/ 2>/dev/null || true

echo "✅ [S&R CoreSync] Auto-synchronization complete: Commit approved."
exit 0
